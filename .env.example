DATABASE_URL="file:./dev.db"
# auto = Prisma Client on Windows/Linux/macOS, node:sqlite adapter on Android/Termux.
DATABASE_CLIENT="auto"
OPENROUTER_API_KEY="replace-with-your-openrouter-key"
# Optional: needed if your normal API key cannot access /api/v1/credits.
OPENROUTER_MANAGEMENT_KEY=""
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="AI Chat OpenRouter"
